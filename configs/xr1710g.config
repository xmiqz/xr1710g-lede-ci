# LEDE target seed for Gemtek XR1710G.
# Generate the final .config with: make defconfig

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g=y
CONFIG_aarch64=y
CONFIG_ARCH_64BIT=y

# The XR1710G image recipe builds a FIT recovery image and a FIT sysupgrade
# image. The recovery image is useful for the HTTP recovery / test workflow.
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# LuCI's normal collection already selects this package; keep it explicit so
# the Software page remains available if the collection changes.
CONFIG_PACKAGE_luci-app-package-manager=y

# XR1710G-specific status and hardware-control packages. These are vendored
# from the XR1710G source-2.0 tree under packages/ so the build is not tied to
# a third-party feed that can change independently of LEDE.
CONFIG_PACKAGE_xr1710g-status-core=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-airoha-flowsense=y
CONFIG_PACKAGE_luci-app-airoha-fancontrol=y

# NPU / PPE observability (stage 0). The Airoha driver exposes PPE and flow
# accounting only when NET_AIROHA_FLOW_STATS is built in; LEDE's an7581
# config-6.18 leaves it unset. This is a kernel symbol, so it is carried here
# and merged by make defconfig.
CONFIG_NET_AIROHA_FLOW_STATS=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y

# Stage 2: spread mt76-npu/mt7996 interrupts off CPU0 and ship the
# offload verification tool. Package lives in packages/xr1710g-npu-tuning.
CONFIG_PACKAGE_xr1710g-npu-tuning=y

# Parity with iStoreOS 2.02 measurements: ethtool (full variant, netlink)
# and iperf3 must exist on the device so every matrix row can be measured
# locally instead of inferred from the reference AP.
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_iperf3=y

# MLO parity. LEDE only ships wpad / wpad-openssl / wpad-wolfssl /
# wpad-mbedtls (no mesh variant), so take the full openssl build. The
# reference AP runs wpad-mesh-openssl (hostapd 2.12).
CONFIG_PACKAGE_wpad-openssl=y

# Runtime modules the vendored wifi-scripts ucode needs: nl80211 for phy
# enumeration, digest for config hashing, plus the ubus/uci/uloop/fs
# bindings used by ap.uc and hostapd.uc.
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-nl80211=y
CONFIG_PACKAGE_ucode-mod-uloop=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-ubus=y

# The reference AP ships an unsigned 6420-byte regulatory.db that permits
# 6 GHz at 29 dBm. LEDE's kernel defaults to signed-only if this is left
# unset; keep the check off so the bundled db is actually loaded.
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set

# Chinese translations for the device-specific pages.
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
CONFIG_PACKAGE_luci-i18n-airoha-flowsense-zh-cn=y
CONFIG_PACKAGE_luci-i18n-airoha-fancontrol-zh-cn=y

# Nikki is vendored from the LEDE feeds and upstream nikkinikki-org project.
# Selecting the translation also selects the app and the local prebuilt
# yq/mihomo runtime through the package dependency chain.
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# Argon is shipped by the LEDE luci feed. The CI overlay selects it as the
# default theme on first boot; Bootstrap remains installed as a fallback.
CONFIG_PACKAGE_luci-theme-argon=y

# The LEDE feed includes the Attended Sysupgrade client, but the public OpenWrt
# ASU server does not know about this custom LEDE target. Do not enable it
# unless you also operate a compatible ASU server.
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set

# Add your own package choices below after checking the manifest, for example:
# CONFIG_PACKAGE_luci-app-dockerman=y
# CONFIG_PACKAGE_luci-app-samba4=y
# CONFIG_PACKAGE_luci-app-tailscale=y
